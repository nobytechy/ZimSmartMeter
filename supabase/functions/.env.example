# Edge Function secrets — TEMPLATE ONLY.
# Copy to supabase/functions/.env (gitignored), fill in, then upload with:
#   npx supabase secrets set --env-file supabase/functions/.env
# The same file also powers local serving:
#   npx supabase functions serve --env-file supabase/functions/.env
# These values live in Supabase's secret store, never in git, never in
# the browser bundle.

PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_MERCHANT_EMAIL=
MANISHAPAY_API_KEY=
APP_URL=http://localhost:5173
